# QQ 开放平台机器人应用凭证
QQ_APP_ID=
QQ_APP_SECRET=

# 默认主动连接 QQ，不需要域名、HTTPS 证书或回调地址
QQ_TRANSPORT=websocket

# 兼容 OpenAI Chat Completions、支持函数调用的模型（自然语言查询必需）
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# 仅 QQ_TRANSPORT=webhook 时使用下面的监听地址和端口
QQ_HOST=127.0.0.1
QQ_PORT=8080
# 两种连接共用：消息去重、可靠回复；群里 @ 机器人触发
QQ_DB_PATH=data/qqbot.sqlite3
QQ_ACCEPT_GROUP_MESSAGES=false
LOG_LEVEL=INFO

# 完美校园电量查询
ELECTRICITY_ENABLED=true
ELECTRICITY_SCHOOL_CODE=1402
ELECTRICITY_PAY_PROJECT=953
ELECTRICITY_ENDPOINT=https://cloudpaygateway.59wanmei.com/paygateway/smallpaygateway/trade
ELECTRICITY_TOKEN=
ELECTRICITY_COOKIE=
ELECTRICITY_TAPP_ID=
ELECTRICITY_MAP_PATH=
ELECTRICITY_DEFAULT_AREA=
ELECTRICITY_COOLDOWN_PATH=data/electricity-test/cooldown.sqlite3
