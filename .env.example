# QQ 开放平台 → 机器人 → 开发设置。这里填写 AppSecret，旧 Token 不使用。
QQ_APP_ID=
QQ_APP_SECRET=

# 默认仅在本机监听，服务器上由 Caddy/Nginx 转发 HTTPS 请求。
QQ_HOST=127.0.0.1
QQ_PORT=8080
QQ_DB_PATH=data/qqbot.sqlite3
LOG_LEVEL=INFO

# 如开放平台已开通群全量消息，可设 true；全量模式只响应 / 开头的命令。
QQ_ACCEPT_GROUP_MESSAGES=false

# 管理页独立运行：uv run qqbot admin，默认只监听127.0.0.1:8081。
# 对外访问时使用HTTPS反向代理，并将管理域名加入此列表（只填主机名）。
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# 人格：cat 猫猫电费管家、friend 校园损友、gentle 温柔助手、custom 自定义。
BOT_NAME=小电
BOT_PERSONA=cat
BOT_PERSONA_CUSTOM=
BOT_CATCHPHRASE=
BOT_REPLY_LENGTH=balanced
# 可选按群覆盖，例如 {"群OpenID":"friend"}；在群里发送 /人设 获取标识。
BOT_GROUP_PERSONAS={}
# 仅在用户明确登记后保存昵称/宿舍。默认开启查询台账，不保存普通聊天原文。
MEMORY_ENABLED=true
# 按需关闭骰子和抽签，关闭后模型也不会获得这些工具。
GAMES_ENABLED=true
# 通用文档技能：在管理页上传并单独启用。目录留在data内，不提交Git。
SKILLS_ENABLED=true
SKILLS_DIR=data/skills
ELECTRICITY_HISTORY_ENABLED=true
ELECTRICITY_HISTORY_RETENTION_DAYS=365

# 兼容 OpenAI Chat Completions 的模型；需要支持 tools/function calling。
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30

# 完美校园电量查询。会话信息按当前有效抓包配置，不能上传 GitHub。
ELECTRICITY_ENABLED=false
ELECTRICITY_SCHOOL_CODE=1402
ELECTRICITY_PAY_PROJECT=953
ELECTRICITY_ENDPOINT=https://cloudpaygateway.59wanmei.com/paygateway/smallpaygateway/trade
ELECTRICITY_TOKEN=
ELECTRICITY_COOKIE=
ELECTRICITY_TAPP_ID=

# 空值使用内置旧映射。可导出并维护 JSON 目录，添加房号别名、区分重名楼。
ELECTRICITY_MAP_PATH=
# 可固定查询区域/主菜单，例如 1、2、3；具体含义以当前学校的目录为准。
ELECTRICITY_DEFAULT_AREA=
